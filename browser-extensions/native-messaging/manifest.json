{
  "manifest_version": 3,
  "name": "Act Track AI MD Browser Bridge",
  "version": "0.1.0",
  "description": "Forwards active tab visits to the Act Track AI MD native host.",
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "act-track-ai-md@irdan.com",
      "strict_min_version": "109.0"
    }
  }
}
