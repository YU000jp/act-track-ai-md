{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActTrack AI MD",
  "version": "1.0.0",
  "identifier": "com.irdan.acttrackaimd",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend:clean",
    "beforeBuildCommand": "pnpm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "dist/dashboard"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ActTrack AI MD Dashboard",
        "visible": false,
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
